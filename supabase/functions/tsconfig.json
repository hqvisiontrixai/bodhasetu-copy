{
  "compilerOptions": {
    "target": "ES2020",
    "lib": ["ES2020"],
    "module": "ES2020",
    "moduleResolution": "node",
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true,
    "types": ["./types.d.ts"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
